# =====================================================================
# Repéré — variables d'environnement
# Copiez ce fichier en .env.local (dev) ou saisissez-les dans Vercel > Settings > Environment Variables.
# En développement, TOUTES sont facultatives : sans elles, l'app tourne en MODE DÉMO
# (IA simulées, données dans .data/, e-mails affichés dans la console, paiement simulé).
# En PRODUCTION (VERCEL_ENV=production ou APP_ENV=production), src/lib/env.ts REFUSE DE DÉMARRER si une variable
# marquée OBLIGATOIRE manque ou est mal formée (sauf DEMO_MODE=1, démo assumée). Contrôle : GET /api/health.
# Vérifier que ce fichier couvre tout ce que lit le code : node scripts/ops/check-env.mjs

# --- Mode et observabilité ----------------------------------------------------
# 1 = démo assumée (même en production : données simulées, aucun paiement réel)
DEMO_MODE=
# production pour un hébergement hors Vercel (équivaut à VERCEL_ENV=production)
APP_ENV=
# debug | info | warn | error (défaut info ; warn pendant les tests)
LOG_LEVEL=
# Remontée d'erreurs compatible Sentry (offre gratuite) par HTTP, sans SDK : https://<clé>@oXXX.ingest.sentry.io/<projet>
SENTRY_DSN=
# =====================================================================

# --- Site -------------------------------------------------------------
# URL publique, sans slash final (liens des e-mails, retours Stripe). OBLIGATOIRE en production (https://)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Repéré

# --- IA (moteur d'audit) — une clé manquante = provider remplacé par "mock" ---
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Mistral (Le Chat), IA en option
MISTRAL_API_KEY=
# Modèles (facultatif, les noms changent vite — voir docs/04-api-ia.md)
OPENAI_MODEL=
PERPLEXITY_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=
MISTRAL_MODEL=
# Modèles d'extraction des concurrents (vide = modèle par défaut du fournisseur)
OPENAI_EXTRACT_MODEL=
ANTHROPIC_EXTRACT_MODEL=
GEMINI_EXTRACT_MODEL=
MISTRAL_EXTRACTOR_MODEL=
# Révision de l'API Gemini (v1beta par défaut)
GEMINI_API_REVISION=
# Budget IA par audit en € (gratuit / payant), appels simultanés, délai et reprises par appel
AUDIT_BUDGET_EUR=
AUDIT_BUDGET_PAID_EUR=
AUDIT_CONCURRENCY=
AUDIT_TIMEOUT_MS=
AUDIT_RETRIES=
# Ancrage Google Search de Gemini : off par défaut, tant que les CGU de l'ancrage (« Grounded Results » :
# ni cache, ni revente, affichage des suggestions de recherche) ne sont pas validées. Mettre on pour l'activer.
GEMINI_GROUNDING=off

# --- Supabase (base de données + connexion par lien magique) -----------
# Sans ces 2 variables serveur : store local .data/*.json (démo). OBLIGATOIRES en production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Vérification locale des jetons de session (HS256) : Supabase > Settings > API > JWT Secret (facultatif, plus rapide)
SUPABASE_JWT_SECRET=
# Côté navigateur (connexion à l'app) — clé "anon" publique uniquement. Lue AU BUILD pour la CSP (connect-src).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe -------------------------------------------------------------
# Sans clé : /api/checkout renvoie /merci?demo=1. OBLIGATOIRES en production (sk_live_…, whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Taux de TVA fixe (txr_...) appliqué à chaque ligne ; vide = pas de TVA (franchise en base)
STRIPE_TAX_RATE_ID=
# Un price id (price_...) par offre de docs/07-plans.json : STRIPE_PRICE_<PLANID>
# Grille V2 (docs/v2/07-plans-v2.json). Accompagné : engagement 3 mois porté par la metadata Stripe.
STRIPE_PRICE_LOCAL_AUDIT_DEEP=
STRIPE_PRICE_LOCAL_ESSENTIEL_MONTH=
STRIPE_PRICE_LOCAL_ESSENTIEL_YEAR=
STRIPE_PRICE_LOCAL_ACCOMPAGNE_MONTH=
STRIPE_PRICE_LOCAL_RESEAU_MONTH=
STRIPE_PRICE_LOCAL_RESEAU_YEAR=
STRIPE_PRICE_PME_AUDIT_DEEP=
STRIPE_PRICE_PME_ESSENTIEL_MONTH=
STRIPE_PRICE_PME_ESSENTIEL_YEAR=
STRIPE_PRICE_PME_ACCOMPAGNE_MONTH=
STRIPE_PRICE_ECOM_AUDIT_DEEP=
STRIPE_PRICE_ECOM_ESSENTIEL_MONTH=
STRIPE_PRICE_ECOM_ESSENTIEL_YEAR=
STRIPE_PRICE_ECOM_ACCOMPAGNE_MONTH=
# Agence : liste d'attente (non achetable) tant que la marque blanche n'est pas livrée
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
# Offres V1 conservées (abonnés existants, anciens liens)
STRIPE_PRICE_ACTION_PLAN=
STRIPE_PRICE_SUIVI_MONTH=
STRIPE_PRICE_SUIVI_YEAR=
STRIPE_PRICE_BUNDLE_START=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=

# --- E-mail (Resend) -------------------------------------------------------
# Sans clé : les e-mails sont écrits dans les logs. OBLIGATOIRE en production (re_…)
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (sous-domaine dédié conseillé)
EMAIL_FROM="Repéré <rapport@hello.votre-domaine.fr>"
EMAIL_REPLY_TO=contact@votre-domaine.fr
# Identité légale affichée en pied d'e-mail (obligatoire en prospection, docs/06-juridique.md E5)
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_SIREN=

# --- Sécurité ----------------------------------------------------------------
# Secret des crons ET du worker de la file (Vercel l'envoie en "Authorization: Bearer ..." ; pg_cron aussi).
# Donne aussi le détail de /api/health. OBLIGATOIRE en production. Générer : openssl rand -hex 32
CRON_SECRET=
# Signature des liens de désinscription /desinscription (OBLIGATOIRE en production, distinct de CRON_SECRET).
# Même valeur à passer à scripts/write-emails.ts.
UNSUBSCRIBE_SECRET=
# Signature des liens du plan d'action PDF (/api/report/[id]/plan?token=…). OBLIGATOIRE en production.
AUDIT_SIGNING_SECRET=
# Sel du hachage des IP pour la limitation de débit (OBLIGATOIRE en production)
RATE_LIMIT_SALT=
# Signature des sessions (cookies httpOnly) et des liens magiques locaux (défaut : AUDIT_SIGNING_SECRET ; à séparer)
AUTH_SECRET=
# 1 = comptes locaux sans Supabase même en production (dépannage uniquement)
AUTH_LOCAL_ACCOUNTS=
# Signature des liens de partage et des rapports planifiés (défaut : UNSUBSCRIBE_SECRET ; à séparer)
SHARE_SECRET=
# Chiffrement des URL et secrets des intégrations Slack / webhook (défaut : SHARE_SECRET ; à séparer)
INTEGRATIONS_SECRET=
# Jeton des scripts de prospection (POST /api/leads source=prospection, en-tête x-admin-token)
ADMIN_TOKEN=

# --- Réglages --------------------------------------------------------------
# Audits gratuits par IP et par jour (défaut 5)
AUDIT_RATE_LIMIT_PER_DAY=5
# Plafonds anti-abus globaux, admin compris (qa/securite.md C1) : ~0,56 € par audit réel
AUDIT_GLOBAL_PER_DAY=300
AUDIT_GLOBAL_PER_HOUR=60
# Audits par adresse e-mail et par jour
AUDIT_PER_EMAIL_PER_DAY=3
# E-mails de rapport envoyés par jour, toutes adresses confondues (qa/securite.md E3)
EMAIL_GLOBAL_PER_DAY=200
# Hors Vercel uniquement : 1 si un proxy de confiance pose X-Forwarded-For
TRUST_PROXY=
# CSP : appliquée par défaut. 1 = Report-Only (diagnostic) ; CSP_DISABLE=1 la retire (urgence uniquement)
CSP_REPORT_ONLY=
CSP_DISABLE=
# Part des rapports de violation CSP journalisés (0 à 1, défaut 0.1)
CSP_REPORT_SAMPLE=0.1

# --- File de tâches (src/lib/jobs, worker /api/cron/worker) ----------------------
# Budget d'un passage du worker en ms (< maxDuration 300 s)
JOBS_WORKER_BUDGET_MS=240000
# Délai maximal d'une tâche (un audit) en ms ; au-delà : annulée et reprogrammée
JOBS_TIMEOUT_MS=90000
# Tâches réservées par tour et exécutées en parallèle
JOBS_BATCH=10
JOBS_CONCURRENCY=2
# Tentatives avant abandon (statut dead, alerte Sentry) ; backoff : base × 2^(tentative−1), plafonné à 6 h
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_MS=60000
# off = ne pas lancer de worker immédiat (after()) pour les tâches urgentes
JOBS_KICK=on
# Dossier du store démo (défaut ./.data)
DATA_DIR=

# --- Variables complémentaires (ajoutées au contrôle final) ---
# URL publique du site (liens des e-mails, PDF, sitemap). Mettre la même valeur dans les trois.
NEXT_PUBLIC_SITE_URL=https://repere-ia.fr
SITE_URL=https://repere-ia.fr
APP_URL=https://repere-ia.fr
NEXT_PUBLIC_CONTACT_EMAIL=contact@repere-ia.fr
# Clé publique Supabase (connexion par lien magique dans l'app)
SUPABASE_ANON_KEY=
# (obsolète V3) NEXT_PUBLIC_STRIPE_PORTAL_URL : le portail Stripe est créé côté serveur par POST /api/account/portal.
# IA interrogées (par défaut : chatgpt,perplexity,gemini) et IA d'extraction des concurrents (par défaut : la moins chère disponible)
AUDIT_PROVIDERS=chatgpt,perplexity,gemini
AUDIT_EXTRACTOR=
# Notifications push web (optionnel, V1.1)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Dev / tests : off = ne pas lire le site du client pour suggérer des questions
PROMPTS_SITE_FETCH=
# Dev uniquement
RATE_LIMIT_PERSIST=
NEXT_PUBLIC_SW_DEV=

# --- V2 : copilote ------------------------------------------------------------
# Sans ANTHROPIC_API_KEY ni OPENAI_API_KEY : réponses préparées (mode démo) à partir des données du compte.
# Modèle du copilote (Anthropic prioritaire, sinon OpenAI). Vide = ANTHROPIC_MODEL / OPENAI_MODEL.
ANTHROPIC_MODEL_COPILOT=
OPENAI_MODEL_COPILOT=
# Plafond de dépense LLM du copilote par jour, tous clients (au-delà : réponses préparées). Défaut 2.
COPILOT_DAILY_BUDGET_EUR=2
# Plafond par compte et par jour (un compte ne vide pas le budget de tous)
COPILOT_BUSINESS_DAILY_BUDGET_EUR=0.5
# Questions par compte et par jour (défaut 60)
COPILOT_PER_BUSINESS_PER_DAY=60
# Prix d'estimation en € par million de jetons (entrée / sortie), pour le plafond
COPILOT_PRICE_IN_EUR_PER_MTOK=3
COPILOT_PRICE_OUT_EUR_PER_MTOK=15

# --- V2 : digest du lundi ---------------------------------------------------------
# Signature des liens « C'est fait » de l'e-mail (défaut : AUDIT_SIGNING_SECRET). OBLIGATOIRE en production.
DIGEST_SIGNING_SECRET=

# --- V2 : connecteurs (préparés) ---------------------------------------------------
# OAuth Google (GA4 trafic IA, Search Console, Business Profile) — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- V2 : exécution (textes générés : FAQ, réponses aux avis) ---------------------
# EXEC_LLM=off pour forcer les gabarits sans IA ; modèles dédiés (vide = modèles par défaut)
EXEC_LLM=
# Plafond quotidien d'appels LLM d'exécution, tous comptes confondus
EXEC_LLM_DAILY_CALLS=300
EXEC_ANTHROPIC_MODEL=
EXEC_OPENAI_MODEL=

# --- V3 : local (audit de fiche Google) ---------------------------------------------
# API Places (New) : sans clé, saisie guidée + démo
GOOGLE_PLACES_KEY=
# Budget maximal (€) d'une carte de visibilité par quartier (défaut : plafond de l'offre, au plus × 2)
LOCAL_MAP_BUDGET_EUR=
# Rappels du calendrier de posts : cron quotidien vercel.json → /api/local/reminders (Bearer CRON_SECRET)

# --- V3 : e-commerce (connecteur Shopify, désactivé sans clé) ------------------------
# Application Shopify (OAuth) ; URL de retour : <APP_URL>/api/ecommerce/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Version d'API (AAAA-01|04|07|10), défaut 2026-10
SHOPIFY_API_VERSION=

# --- V3 : copilote ------------------------------------------------------------------
# Tours d'appels d'outils par question en mode LLM (1 à 8, défaut 4)
COPILOT_MAX_TOOL_TURNS=

# --- Identité publique (données structurées, pages légales : src/lib/seo/site.ts) ----
NEXT_PUBLIC_LEGAL_NAME=
# Forme juridique, ex. « entrepreneur individuel (micro-entrepreneur) » (obligatoire en production)
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_SIRET=
# Ville du greffe du RCS (société)
NEXT_PUBLIC_LEGAL_RCS_CITY=
# Contact de l'éditeur et directeur de la publication (mentions légales ; obligatoires en production)
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTAL_CODE=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_FOUNDING_DATE=
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_TITLE=
NEXT_PUBLIC_FOUNDER_BIO=
NEXT_PUBLIC_FOUNDER_IMAGE=
NEXT_PUBLIC_FOUNDER_LINKEDIN=
# Profils officiels (URL séparées par des virgules)
NEXT_PUBLIC_SAME_AS=

# --- V3 : intégration (src/instrumentation.ts, middleware, croissance) -----------------
# CSP à nonce par requête sur les pages dynamiques (/app, /bienvenue, /connexion, /inscription, /r) : on par défaut.
# off = seule la CSP statique de next.config.ts s'applique (dépannage).
CSP_NONCE=
# Parrainage (src/lib/growth) : JSON facultatif, défaut 1 mois offert à chacun, plafond 6 par an.
# Exemple : {"referrerMonths":1,"refereeMonths":1,"annualCapMonths":6}
GROWTH_REFERRAL_REWARD=
# Stripe : activer l'événement « invoice.paid » sur le webhook (récompense de parrainage au premier paiement réel).

# --- Scripts de mise en ligne seulement (scripts/ops/migrate.mjs), jamais dans Vercel -----
# Supabase › Connect › Session pooler › URI
DATABASE_URL=

# --- V5 : données SEO (src/lib/seodata, docs/v5/donnees-seo.md) ----------------------------
# Sans ces clés : chaque source s'affiche « non configurée », aucun chiffre n'est inventé (comptes démo : données démo).
# Search Console : réutilise GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (ci-dessus). Ajoutez l'URI de redirection
# <APP_URL>/api/v5/connect/google/callback dans la console Google Cloud et activez « Google Search Console API ».
# PageSpeed Insights + CrUX (gratuits) : clé Google Cloud avec « PageSpeed Insights API » et « Chrome UX Report API »
PAGESPEED_API_KEY=
# Clé CrUX distincte (facultatif ; vide = PAGESPEED_API_KEY)
CRUX_API_KEY=
# DataForSEO (positions, volumes, mots-clés positionnés, liens) : paiement à l'appel, plafond par compte et par mois
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Conversion d'estimation des coûts fournisseurs facturés en dollars (défaut 0.92)
SEODATA_EUR_PER_USD=
# Bing Webmaster Tools : aucune variable, la clé API est celle du client (saisie dans l'app, chiffrée au repos).
# Balayage quotidien : GET /api/v5/seodata/cron (Bearer CRON_SECRET), déjà déclaré dans vercel.json.

# --- V5 : analyse 60 s (src/lib/analysis, POST /api/v5/analysis) ----------------------------
# Plafond d'appels IA du contrôle rapide par analyse publique (défaut 18 ; 0 = aucun contrôle IA)
ANALYSIS_MAX_AI_CALLS=
# Limites de débit de l'analyse publique (défauts : 6/h et 15/jour par IP, 4/h par domaine, 120/h et 600/jour au total)
ANALYSIS_RATE_LIMIT_PER_HOUR=
ANALYSIS_RATE_LIMIT_PER_DAY=
ANALYSIS_PER_DOMAIN_PER_HOUR=
ANALYSIS_GLOBAL_PER_HOUR=
ANALYSIS_GLOBAL_PER_DAY=
# Envoi du lien du rapport à l'e-mail saisi (facultatif) : 0 = jamais (défaut : envoyé, 3/jour/adresse, désinscription respectée)
ANALYSIS_EMAIL_REPORT=
# Réanalyses des espaces (tâche analysis.rerun, balayage quotidien par /api/cron/monthly) : pages selon l'offre
# (Découverte 60, Essentiel 500, Accompagné 2 000), bornées par JOBS_TIMEOUT_MS (280000 conseillé pour 2 000 pages).

# --- V5 : optimisation GEO (src/lib/geo) ---------------------------------------------------
# off = aucune IA dans le module GEO (sous-questions et réécritures par gabarits) ; vide = clés IA existantes
GEO_LLM=

# --- V5 : agent de publication (src/lib/publish) -------------------------------------------
# Fiche Google (Business Profile) : 1 seulement après accord d'accès à l'API Google Business Profile
PUBLISH_GBP_ENABLED=
# Shopify : 1 pour écrire robots.txt / llms.txt dans le thème (portée write_themes + exemption Shopify requises)
SHOPIFY_THEME_WRITE=
# Agent automatique : après chaque exploration / réanalyse, brouillons de corrections à valider (jamais appliqués
# sans validation). 0 = coupé (défaut : actif, selon les réglages de l'agent de chaque client)
PUBLISH_AGENT_AUTO=

# --- V5 : baromètres (src/lib/barometre, scripts/barometre/run.ts) --------------------------
# 1 = passe mensuelle automatique (cron quotidien, le 2 du mois ou après). Décision fondateur : ≈ 96,50 €/mois pour 50.
BAROMETRE_ENABLED=
# Budget mensuel IA des baromètres en euros (défaut 120)
BAROMETRE_BUDGET_EUR=
# IA interrogées, ex. chatgpt,perplexity,gemini,claude (défaut : ces 4, + Mistral si clé)
BAROMETRE_PROVIDERS=
# 1 = aperçu de démonstration en local (jamais en production, jamais dans le sitemap ni llms.txt)
BAROMETRE_DEMO_PREVIEW=
